              <li class="flex items-start gap-2.5">
                <span class="text-base mt-0.5">📍</span>
                <span>Club House, Adhiraj Garden, Sector 5,<br />Kharghar, Navi Mumbai – 410210</span>
              </li>
              <li class="flex items-center gap-2.5">
                <span class="text-base">📞</span>
                <a href="tel:+919920155875" class="hover:text-white transition-colors">+91 99201 55875</a>
              </li>
              <li class="flex items-center gap-2.5">
                <span class="text-base">✉️</span>
                <a href="mailto:feelandhealyoga@gmail.com" class="hover:text-white transition-colors">feelandhealyoga@gmail.com</a>
              </li>
              <li class="flex items-center gap-2.5">
                <span class="text-base">🕐</span>
                <span>Mon–Sat: 6:00 AM – 9:00 PM</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- Footer bottom bar -->
        <div class="py-5 text-center text-xs" style="border-top:1px solid hsl(20,15%,24%); color:hsl(38,15%,55%);">
          <p>© 2025 Feel &amp; Heal Yoga · All rights reserved · Made with 🧘 &amp; 🌿 in Kharghar, Navi Mumbai</p>
        </div>
      </footer>
    </main>

    <TrialPopup client:load />

    <YogiChatbot client:load />
  </body>
</html>