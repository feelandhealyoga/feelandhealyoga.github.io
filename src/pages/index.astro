---
import { Navigation } from "../components/Navigation";
import { ScrollspyNav } from "../components/ScrollspyNav";
import { ScrollProgressBar } from "../components/ScrollProgressBar";
import { HeroSection } from "../components/HeroSection";
import { AboutSection } from "../components/AboutSection";
import { InstructorSection } from "../components/InstructorSection";
import { ExperienceSection } from "../components/ExperienceSection";
import { ReasonsSection } from "../components/ReasonsSection";
import { ReviewsSection } from "../components/ReviewsSection";
import { InstagramSection } from "../components/InstagramSection";
import { GallerySection } from "../components/GallerySection";
import { ScheduleSection } from "../components/ScheduleSection";
import { MapSection } from "../components/MapSection";
import { ContactSection } from "../components/ContactSection";
import { TrialPopup } from "../components/TrialPopup";
import { PremiumBackground } from "../components/PremiumBackground";
import YogiChatbot from "../components/yogichatbot.jsx";
import "../index.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="canonical" href="https://feel-and-heal-yoga.netlify.app/" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Feel &amp; Heal Yoga | Yoga Classes in Kharghar, Navi Mumbai</title>

    <meta
      name="description"
      content="Join our yoga classes in Kharghar, Navi Mumbai, to improve your strength, flexibility, and inner peace. We offer online and offline sessions for all levels. Book a free trial!"
    />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://feel-and-heal-yoga.netlify.app/" />
    <meta
      property="og:title"
      content="Yoga Classes in Kharghar, Navi Mumbai | Feel & Heal Yoga"
    />
    <meta
      property="og:description"
      content="Join our yoga classes in Kharghar, Navi Mumbai, to improve your strength, flexibility, and inner peace. We offer online and offline sessions for all levels. Book a free trial!"
    />
    <meta
      property="og:image"
      content="https://feel-and-heal-yoga.netlify.app/assets/hero-yoga.jpg"
    />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://feel-and-heal-yoga.netlify.app/" />
    <meta
      property="twitter:title"
      content="Yoga Classes in Kharghar, Navi Mumbai | Feel & Heal Yoga"
    />
    <meta
      property="twitter:description"
      content="Join our yoga classes in Kharghar, Navi Mumbai, to improve your strength, flexibility, and inner peace. We offer online and offline sessions for all levels. Book a free trial!"
    />
    <meta
      property="twitter:image"
      content="https://feel-and-heal-yoga.netlify.app/assets/hero-yoga.jpg"
    />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "YogaStudio",
        "name": "Feel & Heal Yoga",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Club House, Adhiraj Garden, Sector 5",
          "addressLocality": "Kharghar",
          "addressRegion": "Navi Mumbai",
          "postalCode": "410210",
          "addressCountry": "IN"
        },
        "telephone": "+919920155875",
        "url": "https://feel-and-heal-yoga.netlify.app",
        "image": "https://feel-and-heal-yoga.netlify.app/assets/hero-yoga.jpg",
        "description": "Yoga classes in Kharghar, Navi Mumbai for all levels. Improve wellness, strength, and inner peace.",
        "openingHours": "Mo-Fr 06:00-21:00, Sa 06:00-10:00"
      }
    </script>

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-T1KLN4CD9Q"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-T1KLN4CD9Q");
    </script>
  </head>

  <body>
    <PremiumBackground client:load />
    <Navigation client:load />
    <ScrollspyNav client:load />

    <main>
      <HeroSection client:load />
      <AboutSection client:load />
      <InstructorSection client:load />
      <ExperienceSection client:load />
      <ReasonsSection client:load />
      <ReviewsSection client:load />
      <GallerySection client:load />
      <InstagramSection client:load />
      <ScheduleSection client:load />
      <MapSection client:load />
      <ContactSection client:load />
      <ScrollProgressBar client:load />

      <!-- ═══ YOGIC FOOTER ═══ -->
      <footer style="background: hsl(20,22%,16%); color: hsl(38,35%,92%);">
        <div class="max-w-6xl mx-auto px-6 py-16 grid grid-cols-1 md:grid-cols-3 gap-12">

          <!-- Brand -->
          <div>
            <div class="flex items-center gap-3 mb-4">
              <img src="/assets/feel-and-heal-yoga-logo.svg" alt="Feel & Heal Yoga" class="w-11 h-11 rounded-full brightness-0 invert" />
              <div>
                <span class="font-bold text-lg block" style="font-family:'Playfair Display',serif;">Feel &amp; Heal Yoga</span>
                <span class="text-[10px] tracking-widest uppercase" style="color:hsl(38,80%,62%);">Kharghar · Navi Mumbai</span>
              </div>
            </div>
            <p class="text-sm leading-relaxed mb-5" style="color:hsl(38,20%,70%);">
              A nurturing yoga studio where every session brings you closer to a healthier, calmer, and more vibrant you. 🙏
            </p>
            <!-- Socials -->
            <div class="flex gap-3">
              <a href="https://www.instagram.com/feelandhealyoga/" target="_blank" rel="noopener noreferrer" aria-label="Instagram"
                class="w-9 h-9 rounded-full flex items-center justify-center transition-all hover:scale-110"
                style="background:hsl(38,40%,24%);">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
              </a>
              <a href="https://www.linkedin.com/company/feel-heal-yoga/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"
                class="w-9 h-9 rounded-full flex items-center justify-center transition-all hover:scale-110"
                style="background:hsl(38,40%,24%);">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
              </a>
              <a href="https://wa.me/919920155875" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp"
                class="w-9 h-9 rounded-full flex items-center justify-center transition-all hover:scale-110"
                style="background:hsl(145,40%,28%);">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              </a>
            </div>
          </div>

          <!-- Quick Links -->
          <div>
            <h4 class="font-bold text-sm mb-5 tracking-widest uppercase" style="color:hsl(38,80%,62%);">Quick Links</h4>
            <ul class="space-y-3 text-sm" style="color:hsl(38,20%,70%);">
              <li><a href="#about" class="hover:text-white transition-colors">About Us</a></li>
              <li><a href="#instructor" class="hover:text-white transition-colors">Meet the Instructor</a></li>
              <li><a href="#schedule" class="hover:text-white transition-colors">Class Schedule</a></li>
              <li><a href="#gallery" class="hover:text-white transition-colors">Gallery</a></li>
              <li><a href="#contact" class="hover:text-white transition-colors">Contact</a></li>
            </ul>
          </div>

          <!-- Contact Info -->
          <div>
            <h4 class="font-bold text-sm mb-5 tracking-widest uppercase" style="color:hsl(38,80%,62%);">Get In Touch</h4>
